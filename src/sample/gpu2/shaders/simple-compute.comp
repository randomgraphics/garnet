#version 450
#extension GL_EXT_nonuniform_qualifier : require
// Adds `increment` to a descriptor-indexed storage buffer, up to `count` elements.
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 4) buffer SSBO { float data[]; }
ssbos[];

layout(push_constant) uniform PC {
    uint  count;
    float increment;
    uint  dataIndex;
}
pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pc.count) ssbos[nonuniformEXT(pc.dataIndex)].data[idx] += pc.increment;
}
