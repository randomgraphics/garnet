#version 450
layout(local_size_x = 8, local_size_y = 8) in;
// GENERAL layout is required by Vulkan for storage images accessed via imageLoad/imageStore.
layout(set = 0, binding = 0, rgba8) uniform readonly image2D inputImg;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImg;

void main() {
    ivec2 size  = imageSize(inputImg);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;
    imageStore(outputImg, coord, imageLoad(inputImg, coord));
}
