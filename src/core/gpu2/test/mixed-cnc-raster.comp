#version 450
#extension GL_EXT_nonuniform_qualifier : require
layout(local_size_x = 8, local_size_y = 8) in;

// Storage images are selected by descriptor-heap indices; passResources at set 1 declares
// their read/write use to gpu2's resource-state tracker.
layout(set = 0, binding = 2, rgba8) uniform image2D storageImages[];

layout(push_constant) uniform PushConstants {
    uint inputIndex;
    uint outputIndex;
} pc;

void main() {
    ivec2 size  = imageSize(storageImages[nonuniformEXT(pc.inputIndex)]);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;
    imageStore(storageImages[nonuniformEXT(pc.outputIndex)], coord, imageLoad(storageImages[nonuniformEXT(pc.inputIndex)], coord));
}
