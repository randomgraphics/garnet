#version 450
#extension GL_EXT_nonuniform_qualifier : require

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

// Bindless descriptor heap: array of textures at set 0, binding 0
layout(set = 0, binding = 0) uniform sampler2D u_textures[];

// Pass resource storage buffer: set 1, binding 0
layout(std430, set = 1, binding = 0) buffer OutputBuffer { vec4 outColors[]; };

layout(push_constant) uniform PushConstants {
    uint  textureIndex;
    float multiplier;
}
pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= 16) return;
    vec2 uv          = vec2((float(index) + 0.5) / 16.0, 0.5);
    vec4 c           = texture(u_textures[nonuniformEXT(pc.textureIndex)], uv);
    outColors[index] = c * pc.multiplier;
}
