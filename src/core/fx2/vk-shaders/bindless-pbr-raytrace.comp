#version 460
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_nonuniform_qualifier : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#include "bindless-shared-uniforms.h"
#include "bindless-pbr-material.h"
#include "bindless-sky-material.h"

struct GeometryData {
    uint64_t vertexAddress;
    uint64_t indexAddress;
    uint vertexStride;
    uint positionOffset;
    uint normalOffset;
    uint texcoordOffset;
    uint materialIndex;
    uint vertexCount;
    uint indexCount;
    uint indexFormat;
    mat4 objectToWorld;
};

layout(set = 1, binding = 0) uniform accelerationStructureEXT sceneAccelerationStructure;
layout(set = 1, binding = 2, std430) readonly buffer GeometryTable { GeometryData geometries[]; };
layout(set = 1, binding = 3, rgba16f) uniform writeonly image2D outputImage;

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer FloatData { float values[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer UIntData { uint values[]; };
layout(buffer_reference, std430, buffer_reference_align = 2) readonly buffer UShortData { uint16_t values[]; };

layout(push_constant, std430) uniform DispatchParameters { uint width; uint height; uint skyMaterialIndex; uint padding; } dispatchParameters;
layout(set = 0, binding = 1) uniform texture2D heapTextures[];
layout(set = 0, binding = 1) uniform textureCube heapCubemaps[];
layout(set = 0, binding = 5) uniform sampler heapSamplers[];

const uint ENVIRONMENT_SHADOW_SAMPLES = 8u;
const float PI = 3.14159265359;

uint hashPixel(uvec2 pixel) {
    uint value = pixel.x * 0x9e3779b9u + pixel.y * 0x85ebca6bu;
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    return value ^ (value >> 16);
}

bool environmentDirectionVisible(vec3 position, vec3 normal, vec3 direction) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, sceneAccelerationStructure, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xff,
                          position + normal * 0.001, 0.001, direction, sscUniforms.farPlane);
    while (rayQueryProceedEXT(query)) {}
    return rayQueryGetIntersectionTypeEXT(query, true) == gl_RayQueryCommittedIntersectionNoneEXT;
}

vec3 environmentLighting(SkyMaterialData sky, vec3 normal, vec3 viewDirection, vec3 albedo, float metallic, float roughness,
                         float occlusion, vec3 hitPosition, uvec2 pixel) {
    uint skyboxTexture = sky.textureIndices.x;
    uint skyboxSampler = sky.samplerIndices.x;
    float luminanceScale = sky.factors.x;
    float ambientFloor = sky.factors.y;
    uint seed = hashPixel(pixel);
    float rotation = float(seed & 0x00ffffffu) / 16777216.0;
    vec3 tangent = normalize(abs(normal.y) < 0.999 ? cross(vec3(0.0, 1.0, 0.0), normal) : cross(vec3(1.0, 0.0, 0.0), normal));
    vec3 bitangent = cross(normal, tangent);
    vec3 diffuseEnvironment = vec3(0.0);
    for (uint sampleIndex = 0u; sampleIndex < ENVIRONMENT_SHADOW_SAMPLES; ++sampleIndex) {
        float radialSample = (float(sampleIndex) + 0.5) / float(ENVIRONMENT_SHADOW_SAMPLES);
        float radius = sqrt(radialSample);
        float angle = 2.0 * PI * fract(float(sampleIndex) * 0.61803398875 + rotation);
        vec3 localDirection = vec3(radius * cos(angle), radius * sin(angle), sqrt(1.0 - radialSample));
        vec3 lightDirection = normalize(tangent * localDirection.x + bitangent * localDirection.y + normal * localDirection.z);
        if (!environmentDirectionVisible(hitPosition, normal, lightDirection)) continue;
        vec3 environment = texture(samplerCube(heapCubemaps[nonuniformEXT(skyboxTexture)], heapSamplers[nonuniformEXT(skyboxSampler)]), lightDirection).rgb;
        diffuseEnvironment += max(environment * luminanceScale, vec3(ambientFloor));
    }
    diffuseEnvironment /= float(ENVIRONMENT_SHADOW_SAMPLES);

    float nDotV = max(dot(normal, viewDirection), 0.0);
    vec3 f0 = mix(vec3(0.04), max(albedo, vec3(0.0)), metallic);
    vec3 fresnel = f0 + (max(vec3(1.0 - roughness), f0) - f0) * pow(clamp(1.0 - nDotV, 0.0, 1.0), 5.0);
    vec3 diffuse = (1.0 - fresnel) * (1.0 - metallic) * albedo * diffuseEnvironment * occlusion;

    uint prefilteredTexture = sky.textureIndices.z;
    uint brdfTexture = sky.textureIndices.w;
    uint lutSampler = sky.samplerIndices.y;
    vec3 reflected = reflect(-viewDirection, normal);
    vec3 specularEnvironment = textureLod(samplerCube(heapCubemaps[nonuniformEXT(prefilteredTexture)], heapSamplers[nonuniformEXT(skyboxSampler)]),
                                          reflected, roughness * 4.0).rgb * luminanceScale;
    if (ambientFloor > 0.0) specularEnvironment = max(specularEnvironment, vec3(ambientFloor));
    vec2 brdf = texture(sampler2D(heapTextures[nonuniformEXT(brdfTexture)], heapSamplers[nonuniformEXT(lutSampler)]), vec2(nDotV, roughness)).rg;
    return diffuse + specularEnvironment * (fresnel * brdf.x + brdf.y);
}

vec3 fetchVec3(GeometryData geometry, uint vertex, uint byteOffset) {
    FloatData data = FloatData(geometry.vertexAddress + uint64_t(vertex) * geometry.vertexStride + byteOffset);
    return vec3(data.values[0], data.values[1], data.values[2]);
}

vec2 fetchVec2(GeometryData geometry, uint vertex, uint byteOffset) {
    FloatData data = FloatData(geometry.vertexAddress + uint64_t(vertex) * geometry.vertexStride + byteOffset);
    return vec2(data.values[0], data.values[1]);
}

uint triangleVertex(GeometryData geometry, uint primitive, uint corner) {
    if (geometry.indexCount == 0) return primitive * 3 + corner;
    if (geometry.indexFormat == 1u) {
        UShortData indices = UShortData(geometry.indexAddress);
        return uint(indices.values[primitive * 3 + corner]);
    }
    UIntData indices = UIntData(geometry.indexAddress);
    return indices.values[primitive * 3 + corner];
}

vec3 shadeHit(GeometryData geometry, uint primitive, vec2 barycentrics, vec3 hitPosition, vec3 rayDirection, uvec2 pixel) {
    uint i0 = triangleVertex(geometry, primitive, 0);
    uint i1 = triangleVertex(geometry, primitive, 1);
    uint i2 = triangleVertex(geometry, primitive, 2);
    vec3 bary = vec3(1.0 - barycentrics.x - barycentrics.y, barycentrics.x, barycentrics.y);
    vec3 position0 = fetchVec3(geometry, i0, geometry.positionOffset);
    vec3 position1 = fetchVec3(geometry, i1, geometry.positionOffset);
    vec3 position2 = fetchVec3(geometry, i2, geometry.positionOffset);
    vec3 normal = normalize(fetchVec3(geometry, i0, geometry.normalOffset) * bary.x + fetchVec3(geometry, i1, geometry.normalOffset) * bary.y + fetchVec3(geometry, i2, geometry.normalOffset) * bary.z);
    mat3 normalTransform = transpose(inverse(mat3(geometry.objectToWorld)));
    normal = normalize(normalTransform * normal);
    if (dot(normal, rayDirection) > 0.0) normal = -normal;
    vec2 uv = fetchVec2(geometry, i0, geometry.texcoordOffset) * bary.x + fetchVec2(geometry, i1, geometry.texcoordOffset) * bary.y + fetchVec2(geometry, i2, geometry.texcoordOffset) * bary.z;
    PbrMaterialData material = pbrMaterialHeap.materials[geometry.materialIndex];
    uint flags = material.extraIndices.z;
    vec4 albedo = material.baseColor;
    if ((flags & 1u) != 0u) albedo *= texture(sampler2D(heapTextures[nonuniformEXT(material.textureIndices.x)], heapSamplers[nonuniformEXT(material.extraIndices.y)]), uv);
    float metallic = material.factors.x;
    float roughness = clamp(material.factors.y, 0.04, 1.0);
    float occlusion = 1.0;
    if ((flags & 8u) != 0u) {
        float sampledOcclusion = texture(sampler2D(heapTextures[nonuniformEXT(material.textureIndices.w)], heapSamplers[nonuniformEXT(material.extraIndices.y)]), uv).r;
        occlusion = mix(1.0, sampledOcclusion, material.factors.w);
    }
    if ((flags & 16u) != 0u) {
        vec4 metalRoughness = texture(sampler2D(heapTextures[nonuniformEXT(material.extraIndices.x)], heapSamplers[nonuniformEXT(material.extraIndices.y)]), uv);
        roughness = clamp(roughness * metalRoughness.g, 0.04, 1.0);
        metallic = clamp(metallic * metalRoughness.b, 0.0, 1.0);
    }
    if ((flags & 2u) != 0u) {
        vec2 uv0 = fetchVec2(geometry, i0, geometry.texcoordOffset);
        vec2 uv1 = fetchVec2(geometry, i1, geometry.texcoordOffset);
        vec2 uv2 = fetchVec2(geometry, i2, geometry.texcoordOffset);
        vec3 edge1 = position1 - position0;
        vec3 edge2 = position2 - position0;
        vec2 uvEdge1 = uv1 - uv0;
        vec2 uvEdge2 = uv2 - uv0;
        float determinant = uvEdge1.x * uvEdge2.y - uvEdge1.y * uvEdge2.x;
        if (abs(determinant) > 1e-10) {
            vec3 tangent = normalize(normalTransform * (edge1 * uvEdge2.y - edge2 * uvEdge1.y) / determinant);
            vec3 bitangent = normalize(normalTransform * (-edge1 * uvEdge2.x + edge2 * uvEdge1.x) / determinant);
            vec3 mappedNormal = texture(sampler2D(heapTextures[nonuniformEXT(material.textureIndices.y)], heapSamplers[nonuniformEXT(material.extraIndices.y)]), uv).xyz * 2.0 - 1.0;
            mappedNormal.xy *= material.factors.z;
            normal = normalize(mat3(tangent, bitangent, normal) * mappedNormal);
        }
    }
    vec3 f0 = mix(vec3(0.04), max(albedo.rgb, vec3(0.0)), metallic);
    vec3 viewDirection = normalize(sscUniforms.cameraPosition.xyz - hitPosition);
    vec3 result = material.emissive.rgb;
    if ((flags & 4u) != 0u) result *= texture(sampler2D(heapTextures[nonuniformEXT(material.textureIndices.z)], heapSamplers[nonuniformEXT(material.extraIndices.y)]), uv).rgb;
    for (uint lightIndex = 0; lightIndex < min(sscUniforms.numLights, uint(MAX_SHARED_LIGHTS)); ++lightIndex) {
        DirectLightUniform light = sscUniforms.lights[lightIndex];
        bool directional = int(light.positionOrDir.w + 0.5) == int(SHARED_LIGHT_TYPE_DIRECTIONAL);
        vec3 delta = directional ? -light.positionOrDir.xyz : light.positionOrDir.xyz - hitPosition;
        float distanceToLight = length(delta);
        vec3 lightDirection = delta / max(distanceToLight, 1e-20);
        float nDotL = max(dot(normal, lightDirection), 0.0);
        if (nDotL <= 0.0) continue;
        rayQueryEXT shadowQuery;
        float maxDistance = directional ? 1e30 : max(distanceToLight - 0.002, 0.001);
        rayQueryInitializeEXT(shadowQuery, sceneAccelerationStructure, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xff, hitPosition + normal * 0.001, 0.001, lightDirection, maxDistance);
        while (rayQueryProceedEXT(shadowQuery)) {}
        if (rayQueryGetIntersectionTypeEXT(shadowQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) continue;
        float attenuation = directional ? 1.0 : 1.0 / max(distanceToLight * distanceToLight, 1e-4);
        if (!directional && light.colorAndRange.w > 0.0) attenuation *= pow(clamp(1.0 - distanceToLight / light.colorAndRange.w, 0.0, 1.0), 2.0);
        vec3 halfVector = normalize(viewDirection + lightDirection);
        float nDotV = max(dot(normal, viewDirection), 1e-4);
        float nDotH = max(dot(normal, halfVector), 0.0);
        float vDotH = max(dot(viewDirection, halfVector), 0.0);
        float alpha = roughness * roughness;
        float alpha2 = alpha * alpha;
        float denominator = nDotH * nDotH * (alpha2 - 1.0) + 1.0;
        float distribution = alpha2 / max(3.14159265 * denominator * denominator, 1e-6);
        float k = (roughness + 1.0) * (roughness + 1.0) / 8.0;
        float geometryTerm = nDotV / (nDotV * (1.0 - k) + k) * nDotL / (nDotL * (1.0 - k) + k);
        vec3 fresnel = f0 + (1.0 - f0) * pow(clamp(1.0 - vDotH, 0.0, 1.0), 5.0);
        vec3 specular = distribution * geometryTerm * fresnel / max(4.0 * nDotV * nDotL, 1e-5);
        vec3 diffuse = (1.0 - fresnel) * (1.0 - metallic) * albedo.rgb / 3.14159265;
        result += (diffuse + specular) * max(light.colorAndRange.rgb, vec3(0.0)) * attenuation * nDotL * occlusion;
    }
    if (dispatchParameters.skyMaterialIndex != 0xffffffffu) {
        SkyMaterialData sky = skyMaterialHeap.materials[dispatchParameters.skyMaterialIndex];
        result += environmentLighting(sky, normal, viewDirection, albedo.rgb, metallic, roughness, occlusion, hitPosition, pixel);
    }
    return max(result * max(sscUniforms.exposure, 0.0), vec3(0.0));
}

void main() {
    uvec2 pixel = gl_GlobalInvocationID.xy;
    if (pixel.x >= dispatchParameters.width || pixel.y >= dispatchParameters.height) return;
    vec2 ndc = (vec2(pixel) + 0.5) / vec2(dispatchParameters.width, dispatchParameters.height) * 2.0 - 1.0;
    vec4 viewPoint = inverse(sscUniforms.projMatrix) * vec4(ndc, 1.0, 1.0);
    vec3 viewDirection = normalize(viewPoint.xyz / viewPoint.w);
    vec3 origin = sscUniforms.cameraPosition.xyz;
    vec3 direction = normalize((inverse(sscUniforms.viewMatrix) * vec4(viewDirection, 0.0)).xyz);
    rayQueryEXT rayQuery;
    rayQueryInitializeEXT(rayQuery, sceneAccelerationStructure, gl_RayFlagsOpaqueEXT, 0xff, origin, max(sscUniforms.nearPlane, 0.001), direction, sscUniforms.farPlane);
    while (rayQueryProceedEXT(rayQuery)) {}
    vec3 color = vec3(0.015, 0.02, 0.03);
    if (rayQueryGetIntersectionTypeEXT(rayQuery, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
        uint geometryIndex = rayQueryGetIntersectionGeometryIndexEXT(rayQuery, true);
        GeometryData geometry = geometries[geometryIndex];
        float distance = rayQueryGetIntersectionTEXT(rayQuery, true);
        vec3 hitPosition = origin + direction * distance;
        color = shadeHit(geometry, rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true), rayQueryGetIntersectionBarycentricsEXT(rayQuery, true), hitPosition, direction, pixel);
    } else if (dispatchParameters.skyMaterialIndex != 0xffffffffu) {
        SkyMaterialData sky = skyMaterialHeap.materials[dispatchParameters.skyMaterialIndex];
        color = texture(samplerCube(heapCubemaps[nonuniformEXT(sky.textureIndices.x)], heapSamplers[nonuniformEXT(sky.samplerIndices.x)]), direction).rgb * sky.factors.x;
        color = max(color, vec3(sky.factors.y)) * max(sscUniforms.exposure, 0.0);
    }
    color = color / (color + vec3(1.0));
    imageStore(outputImage, ivec2(pixel), vec4(color, 1.0));
}
