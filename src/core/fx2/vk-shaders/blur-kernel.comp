#version 450
#extension GL_GOOGLE_include_directive : require
#define BLUR
#include "image-filter.h"
layout(local_size_x = 8, local_size_y = 8) in;
layout(rgba8, set = 1, binding = 1) uniform writeonly image2D destinationImage;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (all(lessThan(p, parameters.dimensions.zw))) imageStore(destinationImage, p, filterPixel(p));
}
